# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
# Get yours from: Google Analytics > Admin > Data Streams > Web > Measurement ID
NEXT_PUBLIC_GA_ID=

# Base canonical URL for SEO and social sharing cards (OpenGraph / Twitter)
NEXT_PUBLIC_APP_URL=

# Optional: Official Kick API credentials (for high-volume global indexation)
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
